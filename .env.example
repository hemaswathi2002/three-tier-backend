# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=ecommerce_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# AWS RDS PostgreSQL Configuration
DB_HOST=your-rds-endpoint.c9xxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=YourStrongDatabasePassword123!
DB_SSL=true

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
